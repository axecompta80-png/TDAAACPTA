# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
# Sert aussi d'origine CORS autorisée par défaut (voir ALLOWED_ORIGINS).
APP_URL="MY_APP_URL"

# ALLOWED_ORIGINS: origines supplémentaires autorisées en CORS (séparées par des virgules),
# utile si le frontend est hébergé séparément du serveur API. Facultatif.
# ALLOWED_ORIGINS="https://autre-domaine.example.com,https://app.example.com"

# PORT: port d'écoute du serveur, injecté automatiquement par la plupart des hébergeurs (Render, Railway...).
# Par défaut 3000 en local.
# PORT=3000

# DATABASE_URL / DATABASE_URL_UNPOOLED: connexions Postgres (Neon ou locale).
DATABASE_URL="postgresql://user:password@host:5432/db"
DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/db"

# JWT_SECRET: signe les cookies de session de l'authentification. Générer avec :
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="MY_JWT_SECRET"

# Optionnel : modèles Gemini utilisés par l'agent (par défaut gemini-3.6-flash, puis alias -latest en repli)
# Les versions figées comme gemini-2.5-flash sont retirées par Google et renvoient 404.
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_MODEL_LITE=gemini-flash-lite-latest
