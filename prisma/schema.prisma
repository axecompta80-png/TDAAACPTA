generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums (miroir des unions TypeScript de src/types.ts) ----------

enum RegimeFiscal {
  REEL_SIMPLIFIE      @map("Réel Simplifié")
  REEL_NORMAL         @map("Réel Normal")
  SYNTHETIQUE_FORFAIT @map("Synthétique / Forfait")
}

enum UserRole {
  ADMIN // concepteurs : espace /admin + espace comptable de leur entreprise
  COMPTABLE // compte principal d'une entreprise, ou propriétaire d'un dossier (User.dossierId)
}

enum AccountCategory {
  bilan_actif
  bilan_passif
  charge
  produit
  tresorerie
}

// Cycle de vie : draft -> pending_review (ou anomaly) -> validated -> cancelled
enum TransactionStatus {
  draft
  pending_review
  anomaly
  validated
  cancelled
}

enum InvoiceStatus {
  draft
  pending_review
  validated
  cancelled
}

// Facture client, avoir client (annule tout ou partie d'une facture client), facture fournisseur.
enum InvoiceKind {
  sale
  credit_note
  purchase
}

enum InvoiceMode {
  cash
  credit
}

enum InputMode {
  text
  voice
  photo
  mobile_money
  manual
  excel_import
}

enum PaymentMethod {
  cash
  orange_money
  mtn_momo
  wave
  moov_money
  bank_transfer
  cheque
}

enum AuditAction {
  created_by_ai
  validated_by_expert
  auto_validated
  edited_by_expert
  anomaly_flagged
  submitted_for_review
  unvalidated
  cancelled
  reversed
}

// Journaux : ventes, achats, banque & Mobile Money, caisse, opérations diverses, à-nouveaux.
enum JournalCode {
  VT
  AC
  BQ
  CA
  OD
  AN
}

enum NotificationType {
  info
  success
  warning
  error
}

enum NotificationCategory {
  compta
  fiscal
  tresorerie
  ia
  system
}

enum AiModelPreference {
  GEMINI_2_5_FLASH      @map("gemini-2.5-flash")
  GEMINI_2_5_FLASH_LITE @map("gemini-2.5-flash-lite")
  HEURISTIC_FAST        @map("heuristic-fast")
}

enum StartupView {
  simplified
  expert
}

enum NumberFormatting {
  standard
  compact
}

enum SoundType {
  fintech_chime
  crystal_bell
  soft_chord
  alert_warning
}

// ---------- Modèles ----------

// Une comptabilité. isMain = la comptabilité de l'entreprise elle-même (une par organisation) ;
// les autres sont des dossiers confiés chacun à un propriétaire (User.dossierId).
model ClientDossier {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  isMain         Boolean      @default(false)
  owner          User?        @relation("DossierOwner")
  ownerName      String?
  name           String
  managerName    String
  phone          String
  activity       String
  city           String
  country        String
  rccm           String
  ifu            String
  regimeFiscal   RegimeFiscal
  currency       String
  // Écritures datées jusqu'à ce jour inclus : bloquées (période déclarée ou exercice clôturé).
  lockedUntil    DateTime?    @db.Date
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  journalEntries JournalEntry[]
  notifications  AppNotification[]
  accounts       SyscohadaAccount[]
  invoices       Invoice[]
  recurring      RecurringEntry[]
  assets         FixedAsset[]
  settings       PlatformSettings?

  @@index([organizationId])
  @@map("client_dossiers")
}

model Organization {
  id        String          @id @default(uuid())
  name      String
  createdAt DateTime        @default(now())
  users     User[]
  dossiers  ClientDossier[]

  @@map("organizations")
}

// dossierId null = plan SYSCOHADA standard ; sinon compte propre à un dossier.
// ponytail: code unique pour toute la plateforme (deux dossiers ne peuvent pas réutiliser le même code) ;
// passer à une clé (dossierId, code) si ce besoin apparaît.
model SyscohadaAccount {
  code        String          @id
  label       String
  classNumber Int
  category    AccountCategory
  parentCode  String?
  active      Boolean         @default(true)
  dossierId   String?
  dossier     ClientDossier?  @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  lines JournalLine[]

  @@index([dossierId])
  @@map("syscohada_accounts")
}

model JournalEntry {
  id                    String            @id @default(uuid())
  date                  DateTime          @db.Date
  label                 String
  pieceRef              String
  journal               JournalCode       @default(OD)
  // Numéro d'ordre dans le journal du dossier.
  number                Int
  // Total débit (= total crédit) des lignes.
  amount                Decimal           @db.Decimal(14, 2)
  clientDossierId       String
  clientDossier         ClientDossier     @relation(fields: [clientDossierId], references: [id], onDelete: Cascade)
  status                TransactionStatus @default(pending_review)
  detectedAnomaly       String?
  rawInput              String
  inputType             InputMode
  explanationSimplified String
  paymentMethod         PaymentMethod
  createdAt             DateTime          @default(now())
  // Séparation des tâches : celui qui saisit ou modifie ne peut pas valider.
  createdById           String?
  updatedById           String?
  validatedById         String?
  validatedAt           DateTime?
  invoiceId             String?
  invoice               Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  // Écriture contre-passée par celle-ci.
  reversalOfId          String?
  reversalOf            JournalEntry?     @relation("Reversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversals             JournalEntry[]    @relation("Reversal")

  lines       JournalLine[]
  auditTrail  AuditLog[]
  payments    InvoicePayment[]
  attachments Attachment[]

  @@unique([clientDossierId, journal, number])
  @@index([clientDossierId])
  @@map("journal_entries")
}

// Écriture répétée chaque mois (loyer, abonnement) : générée à l'ouverture de l'application quand nextDate est échue.
model RecurringEntry {
  id              String        @id @default(uuid())
  clientDossierId String
  clientDossier   ClientDossier @relation(fields: [clientDossierId], references: [id], onDelete: Cascade)
  label           String
  journal         JournalCode
  // Lignes au format JournalLine (compte, débit, crédit, libellé).
  lines           Json
  paymentMethod   PaymentMethod
  // Jour du mois voulu (29 à 31 ramené au dernier jour des mois courts).
  day             Int
  nextDate        DateTime      @db.Date
  active          Boolean       @default(true)
  createdById     String?
  createdAt       DateTime      @default(now())

  @@index([clientDossierId])
  @@map("recurring_entries")
}

// Ligne d'écriture : un compte, au débit OU au crédit. Total débit = total crédit par écriture.
model JournalLine {
  id           String           @id @default(uuid())
  entryId      String
  entry        JournalEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  position     Int
  accountCode  String
  account      SyscohadaAccount @relation(fields: [accountCode], references: [code])
  label        String?
  debit        Decimal          @default(0) @db.Decimal(14, 2)
  credit       Decimal          @default(0) @db.Decimal(14, 2)
  /// Rapprochement bancaire : date du relevé sur lequel la ligne a été pointée.
  reconciledOn DateTime?        @db.Date

  @@index([entryId])
  @@index([accountCode])
  @@map("journal_lines")
}

/// Pièce justificative (facture, reçu, relevé) jointe à une écriture.
/// ponytail: fichiers stockés en base (bytea) ; passer à un stockage objet si le volume dépasse quelques Go.
model Attachment {
  id          String       @id @default(uuid())
  entryId     String
  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  filename    String
  mimeType    String
  size        Int
  data        Bytes
  createdById String?
  createdAt   DateTime     @default(now())

  @@index([entryId])
  @@map("attachments")
}

/// Immobilisation amortie en linéaire, prorata temporis.
model FixedAsset {
  id                 String        @id @default(uuid())
  clientDossierId    String
  clientDossier      ClientDossier @relation(fields: [clientDossierId], references: [id], onDelete: Cascade)
  label              String
  accountCode        String
  acquisitionDate    DateTime      @db.Date
  cost               Decimal       @db.Decimal(14, 2)
  durationYears      Int
  /// Dernier exercice dont la dotation a été passée.
  depreciatedThrough Int?
  createdAt          DateTime      @default(now())

  @@index([clientDossierId])
  @@map("fixed_assets")
}

model AuditLog {
  id             String       @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  timestamp      DateTime     @default(now())
  action         AuditAction
  author         String
  notes          String?
  previousValue  String?

  @@index([journalEntryId])
  @@map("audit_logs")
}

model AppNotification {
  id              String               @id @default(uuid())
  title           String
  message         String
  timestamp       DateTime             @default(now())
  type            NotificationType
  category        NotificationCategory
  read            Boolean              @default(false)
  dossierId       String?
  dossier         ClientDossier?       @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  actionLabel     String?
  actionMode      StartupView?
  actionExpertTab String?

  @@index([dossierId])
  @@map("app_notifications")
}

// Réglages d'un dossier (ceux du dossier principal sont recopiés sur tous les dossiers de l'entreprise).
model PlatformSettings {
  id                         String            @id @default(uuid())
  dossierId                  String            @unique
  dossier                    ClientDossier     @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  syscohadaVersion           String
  cashDeductibilityThreshold Decimal           @db.Decimal(14, 2)
  defaultVatRate             Decimal           @db.Decimal(5, 2)
  autoFlagLargeCashPayments  Boolean
  defaultDebitCashAccount    String
  defaultCreditSalesAccount  String
  defaultDebitExpenseAccount String
  duplicateDetection         Boolean
  aiModelPreference          AiModelPreference
  defaultStartupView         StartupView
  numberFormatting           NumberFormatting
  cabinetName                String
  expertLicenseNumber        String
  soundEnabled               Boolean
  soundType                  SoundType
  soundVolume                Float
  notifyOnAnomaly            Boolean
  notifyOnTaxDeadline        Boolean
  notifyOnMobileMoneySync    Boolean
  updatedAt                  DateTime          @updatedAt

  @@map("platform_settings")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(COMPTABLE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // null : compte principal de l'entreprise ; sinon propriétaire de ce seul dossier.
  dossierId      String?        @unique
  dossier        ClientDossier? @relation("DossierOwner", fields: [dossierId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("users")
}

model Invoice {
  id                  String         @id @default(uuid())
  clientDossierId     String
  clientDossier       ClientDossier  @relation(fields: [clientDossierId], references: [id], onDelete: Cascade)
  kind                InvoiceKind    @default(sale)
  number              String
  // Numéro porté par la facture du fournisseur.
  externalRef         String?
  // Avoir : facture client d'origine. Les champs « customer » désignent le tiers (client ou fournisseur),
  // customerAccountCode son compte (411 ou 401), salesAccountCode le compte de nature (70x, ou 6x / 2x en achat).
  originalInvoiceId   String?
  originalInvoice     Invoice?       @relation("CreditNote", fields: [originalInvoiceId], references: [id], onDelete: SetNull)
  creditNotes         Invoice[]      @relation("CreditNote")
  date                DateTime       @db.Date
  dueDate             DateTime       @db.Date
  mode                InvoiceMode
  paymentMethod       PaymentMethod?
  customerName        String
  customerPhone       String?
  customerEmail       String?
  customerAddress     String?
  customerTaxId       String?
  customerAccountCode String         @default("4111")
  salesAccountCode    String         @default("7011")
  vatRate             Decimal        @db.Decimal(5, 2)
  totalHT             Decimal        @db.Decimal(14, 2)
  totalTVA            Decimal        @db.Decimal(14, 2)
  totalTTC            Decimal        @db.Decimal(14, 2)
  paymentTerms        String?
  notes               String?
  status              InvoiceStatus  @default(draft)
  createdById         String?
  updatedById         String?
  validatedById       String?
  validatedAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  lines    InvoiceLine[]
  payments InvoicePayment[]
  entries  JournalEntry[]

  @@unique([clientDossierId, number])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position    Int
  description String
  quantity    Decimal @db.Decimal(14, 3)
  unitPrice   Decimal @db.Decimal(14, 2)
  amountHT    Decimal @db.Decimal(14, 2)

  @@index([invoiceId])
  @@map("invoice_lines")
}

// Lettrage : rattache tout ou partie d'un règlement (écriture au crédit du 411) à une facture.
model InvoicePayment {
  id          String       @id @default(uuid())
  invoiceId   String
  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  entryId     String
  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  amount      Decimal      @db.Decimal(14, 2)
  createdById String?
  createdAt   DateTime     @default(now())

  @@index([invoiceId])
  @@index([entryId])
  @@map("invoice_payments")
}
